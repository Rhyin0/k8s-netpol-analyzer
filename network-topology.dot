digraph K8sNetworkPolicy {
  rankdir=LR;
  node [shape=box, style=filled, fontname="Arial"];
  edge [fontname="Microsoft YaHei", fontsize=10];

  subgraph cluster_0 {
    label="基础设施";
    style=filled;
    color="#F3E5F5";
    "rabbitmq" [fillcolor="#EF5350"];
  }

  subgraph cluster_1 {
    label="监控";
    style=filled;
    color="#ECEFF1";
    "log-collector" [fillcolor="#EF5350"];
    "prometheus" [fillcolor="#66BB6A"];
  }

  subgraph cluster_2 {
    label="入口层";
    style=filled;
    color="#E8F5E9";
    "nginx-ingress" [fillcolor="#EF5350"];
    "web-frontend" [fillcolor="#EF5350"];
    "api-gateway" [fillcolor="#EF5350"];
  }

  subgraph cluster_3 {
    label="业务服务层";
    style=filled;
    color="#E3F2FD";
    "payment-service" [fillcolor="#EF5350"];
    "admin-panel" [fillcolor="#EF5350"];
    "data-exporter" [fillcolor="#EF5350"];
    "order-service" [fillcolor="#EF5350"];
    "auth-service" [fillcolor="#EF5350"];
    "product-service" [fillcolor="#EF5350"];
    "user-service" [fillcolor="#EF5350"];
    "notification-service" [fillcolor="#EF5350"];
    "search-service" [fillcolor="#EF5350"];
  }

  subgraph cluster_4 {
    label="数据层";
    style=filled;
    color="#FFF3E0";
    "redis-cache" [fillcolor="#EF5350"];
    "user-db" [fillcolor="#EF5350"];
    "payment-db" [fillcolor="#EF5350"];
    "elasticsearch" [fillcolor="#EF5350"];
    "order-db" [fillcolor="#EF5350"];
    "product-db" [fillcolor="#EF5350"];
  }

  "admin-panel" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "admin-panel" -> "log-collector" [label="*/*", style=dashed, color=red];
  "admin-panel" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "admin-panel" -> "prometheus" [label="*/*", style=dashed, color=red];
  "api-gateway" -> "auth-service" [label="TCP/8085"];
  "api-gateway" -> "order-service" [label="TCP/8082"];
  "api-gateway" -> "product-service" [label="TCP/8083"];
  "api-gateway" -> "search-service" [label="TCP/8084"];
  "api-gateway" -> "user-service" [label="TCP/8081"];
  "auth-service" -> "redis-cache" [label="TCP/6379"];
  "auth-service" -> "user-db" [label="TCP/5432"];
  "data-exporter" -> "log-collector" [label="TCP/443"];
  "data-exporter" -> "nginx-ingress" [label="TCP/443"];
  "data-exporter" -> "prometheus" [label="TCP/443"];
  "elasticsearch" -> "admin-panel" [label="TCP/9090"];
  "elasticsearch" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "elasticsearch" -> "log-collector" [label="*/*", style=dashed, color=red];
  "elasticsearch" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "elasticsearch" -> "prometheus" [label="*/*", style=dashed, color=red];
  "log-collector" -> "elasticsearch" [label="TCP/9200"];
  "nginx-ingress" -> "api-gateway" [label="TCP/8080"];
  "nginx-ingress" -> "web-frontend" [label="TCP/3000"];
  "notification-service" -> "redis-cache" [label="TCP/6379"];
  "order-db" -> "admin-panel" [label="TCP/9090"];
  "order-db" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "order-db" -> "log-collector" [label="*/*", style=dashed, color=red];
  "order-db" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "order-db" -> "prometheus" [label="*/*", style=dashed, color=red];
  "order-service" -> "order-db" [label="TCP/5432"];
  "order-service" -> "payment-service" [label="TCP/8087"];
  "order-service" -> "product-service" [label="TCP/8083"];
  "order-service" -> "rabbitmq" [label="TCP/5672"];
  "order-service" -> "user-service" [label="TCP/8081"];
  "payment-db" -> "admin-panel" [label="TCP/9090"];
  "payment-db" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "payment-db" -> "log-collector" [label="*/*", style=dashed, color=red];
  "payment-db" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "payment-db" -> "prometheus" [label="*/*", style=dashed, color=red];
  "payment-service" -> "payment-db" [label="TCP/5432"];
  "payment-service" -> "rabbitmq" [label="TCP/5672"];
  "product-db" -> "admin-panel" [label="TCP/9090"];
  "product-db" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "product-db" -> "log-collector" [label="*/*", style=dashed, color=red];
  "product-db" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "product-db" -> "prometheus" [label="*/*", style=dashed, color=red];
  "product-service" -> "product-db" [label="TCP/5432"];
  "product-service" -> "rabbitmq" [label="TCP/5672"];
  "product-service" -> "redis-cache" [label="TCP/6379"];
  "rabbitmq" -> "notification-service" [label="TCP/8086"];
  "redis-cache" -> "admin-panel" [label="TCP/9090"];
  "redis-cache" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "redis-cache" -> "log-collector" [label="*/*", style=dashed, color=red];
  "redis-cache" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "redis-cache" -> "prometheus" [label="*/*", style=dashed, color=red];
  "search-service" -> "elasticsearch" [label="TCP/9200"];
  "search-service" -> "product-service" [label="TCP/8083"];
  "user-db" -> "admin-panel" [label="TCP/9090"];
  "user-db" -> "data-exporter" [label="*/*", style=dashed, color=red];
  "user-db" -> "log-collector" [label="*/*", style=dashed, color=red];
  "user-db" -> "nginx-ingress" [label="*/*", style=dashed, color=red];
  "user-db" -> "prometheus" [label="*/*", style=dashed, color=red];
  "user-service" -> "auth-service" [label="TCP/8085"];
  "user-service" -> "notification-service" [label="TCP/8086"];
  "user-service" -> "redis-cache" [label="TCP/6379"];
  "user-service" -> "user-db" [label="TCP/5432"];
  "web-frontend" -> "api-gateway" [label="TCP/8080"];
}
